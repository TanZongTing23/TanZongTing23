<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity4">

    <EditText
        android:id="@+id/tx_housingloan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Housing Loan"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/tx_enteramount2"
        android:layout_width="match_parent"
        android:layout_height="51dp"
        android:text="Enter Amount:"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/line22"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="number" />

    <TextView
        android:id="@+id/tx_interestrate"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Interest Rate:"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/line44"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="number" />

    <TextView
        android:id="@+id/tx_numberofrepayments2"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Number of Repayments:"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/line66"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="number" />

    <TextView
        android:id="@+id/tx_startedDate"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Started Date:"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/line88"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="date" />

    <Button
        android:id="@+id/Calculatebutton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calculate" />

    <Button
        android:id="@+id/bt_back2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back" />

    <Button
        android:id="@+id/bt_gnrate2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Convert" />

    <EditText
        android:id="@+id/tx_outputanswer2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="number" />

    <EditText
        android:id="@+id/line100"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="date" />

    <EditText
        android:id="@+id/line122"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="number" />

</LinearLayout>